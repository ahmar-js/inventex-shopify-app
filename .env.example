# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"
SHOPIFY_APP_URL="https://your-app.example.com"
SCOPES="read_products,write_products,read_inventory,read_publications,write_publications,read_locations,write_online_store_navigation"
CRON_SECRET="generate-a-long-random-secret"
SUPPORT_EMAIL="support@your-domain.example"
# Resend transactional email. ALERT_FROM_EMAIL is optional in development;
# Inventex <onboarding@resend.dev> is used when it is blank.
RESEND_API_KEY="re_your_resend_api_key"
ALERT_FROM_EMAIL="Inventex <alerts@your-domain.example>"
