// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// ─── App Models ─────────────────────────────────────────────

/// Per-shop automation settings chosen by the merchant
model ShopSettings {
  id                       Int      @id @default(autoincrement())
  shop                     String   @unique
  /// HIDE = unpublish product, PUSH_DOWN = move to bottom of collections
  strategy                 String   @default("HIDE")
  /// ALWAYS = always restore, CONDITIONAL = only if app modified, NONE = never
  restoreBehavior          String   @default("ALWAYS")
  /// Master switch for the automation
  enabled                  Boolean  @default(false)
  /// Classify continue-selling variants separately for collection sorting.
  sortContinueSellingAsOos Boolean  @default(false)
  /// Automatically enable sorting when Shopify creates a collection.
  autoSortNewCollections   Boolean  @default(true)
  /// Store-wide Online Store hiding master switch.
  hideEnabled              Boolean  @default(false)
  /// Days to wait after soldOutAt before hiding a product.
  hideDelayDays            Int      @default(0)
  /// none | home | custom
  redirectMode             String   @default("none")
  /// Same-store path used when redirectMode is custom.
  redirectPath             String   @default("/")
  /// Cached Online Store publication GID.
  onlineStorePublicationId String?
  /// Catalog scan or republish-all job currently locking hide settings.
  hideJobId                String?
  /// Hide sold-out variants from the Online Store publication.
  variantHideEnabled       Boolean  @default(false)
  /// False while the catalog exceeds the 500 published-product beta limit.
  variantHideEligible      Boolean  @default(false)
  /// Published Online Store product count measured by the latest variant scan.
  variantHideCatalogCount  Int?
  /// Catalog scan or variant republish job currently locking this setting.
  variantHideJobId         String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Tracks products that the app has modified (hidden or repositioned)
/// so we can restore them correctly later
model InventoryState {
  id            Int       @id @default(autoincrement())
  shop          String
  productId     String
  productTitle  String    @default("")
  productHandle String?
  /// HIDDEN or PUSHED_DOWN — what the app did to this product
  action        String
  /// Original publication IDs / collection positions, serialized JSON
  previousState String?
  /// Redirect created by Inventex for this hidden product.
  redirectId    String?
  /// Timestamp of when the app modified this product
  modifiedAt    DateTime  @default(now())
  /// Whether this product has been restored already
  restored      Boolean   @default(false)
  restoredAt    DateTime?
  /// Whether the automation action resulted in an error
  error         Boolean   @default(false)
  /// Human-readable error message if action failed
  errorMessage  String?

  @@unique([shop, productId])
  @@index([shop, restored])
}

/// Collections that the automation should apply to.
/// If no rules exist for a shop, automation applies to ALL products.
model CollectionRule {
  id              Int      @id @default(autoincrement())
  shop            String
  /// Full Shopify GID, e.g. gid://shopify/Collection/123456
  collectionId    String
  /// Display title for the UI
  collectionTitle String
  createdAt       DateTime @default(now())

  @@unique([shop, collectionId])
  @@index([shop])
}

/// Products excluded from automation.
/// These products are never hidden or pushed down, even if out of stock.
model ExcludedProduct {
  id           Int      @id @default(autoincrement())
  shop         String
  /// Full Shopify GID, e.g. gid://shopify/Product/123456
  productId    String
  /// Display title for the UI
  productTitle String
  createdAt    DateTime @default(now())

  @@unique([shop, productId])
  @@index([shop])
}

/// Per-shop alert preferences set by the merchant.
model AlertSettings {
  id                 Int      @id @default(autoincrement())
  shop               String   @unique
  /// Master switch — whether any stock alert emails are sent
  lowStockEnabled    Boolean  @default(false)
  /// IMMEDIATE = notify instantly, DAILY = once per day at chosen time, WEEKLY = weekly digest
  alertFrequency     String   @default("IMMEDIATE")
  /// Comma-separated list of up to 5 recipient email addresses.
  alertEmails        String   @default("")
  /// Hour (1–12) for the daily alert — only used when alertFrequency = DAILY
  dailyAlertHour     Int      @default(9)
  /// AM or PM for the daily alert time
  dailyAlertAmPm     String   @default("AM")
  /// IANA timezone name for the daily alert, e.g. "America/New_York"
  dailyAlertTimezone String   @default("America/New_York")
  /// Local weekday for weekly digests (0 = Sunday, 1 = Monday).
  weeklyDigestDay    Int      @default(1)
  /// Last successfully delivered daily or weekly digest.
  lastDigestSentAt   DateTime?
  /// Whether to send an alert when a product falls below lowStockThreshold
  alertOnLowStock    Boolean  @default(true)
  /// Quantity at or below which a "low stock" alert fires (1–5000)
  lowStockThreshold  Int      @default(5)
  /// Whether to send an alert when a product reaches exactly 0 inventory
  alertOnOutOfStock  Boolean  @default(true)
  /// PRODUCT = check total product inventory, VARIANT = check each variant individually
  stockCheckLevel    String   @default("PRODUCT")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Deduplication log — one row per alert actually sent.
/// Used to prevent the same alert firing multiple times within a cooldown window.
model AlertSent {
  id        Int      @id @default(autoincrement())
  shop      String
  /// Full Shopify GID, e.g. gid://shopify/Product/123456
  productId String
  /// Full Shopify GID of the variant, or empty string when stockCheckLevel=PRODUCT
  variantId String   @default("")
  /// LOW_STOCK or OUT_OF_STOCK
  alertType String
  /// IMMEDIATE | DAILY | WEEKLY — which frequency window this covers
  frequency String
  sentAt    DateTime @default(now())

  @@index([shop, productId, alertType, sentAt])
}

/// Queue for DAILY and WEEKLY digest alerts.
/// Records are written when an alert is triggered but not sent immediately.
/// The cron endpoint reads and flushes this table.
model AlertQueue {
  id           Int      @id @default(autoincrement())
  shop         String
  productId    String
  productTitle String   @default("")
  variantId    String   @default("")
  variantTitle String   @default("")
  alertType    String
  /// Inventory quantity at the time the alert was queued
  quantity     Int
  queuedAt     DateTime @default(now())
  /// Whether this row has already been included in a digest
  processed    Boolean  @default(false)

  @@index([shop, processed, queuedAt])
}

/// Variants unpublished by Inventex, used to restore only app-owned changes.
model VariantInventoryState {
  id            Int       @id @default(autoincrement())
  shop          String
  productId     String
  variantId     String
  productTitle  String    @default("")
  variantTitle  String    @default("")
  hiddenAt      DateTime  @default(now())
  restored      Boolean   @default(false)
  restoredAt    DateTime?
  error         Boolean   @default(false)
  errorMessage  String?

  @@unique([shop, variantId])
  @@index([shop, productId])
  @@index([shop, restored])
}

/// Stores per-collection Auto Sorting toggle state chosen by the merchant.
/// Absence of a row means Auto Sorting is disabled for that collection.
model CollectionAutoSorting {
  id                 Int       @id @default(autoincrement())
  shop               String
  /// Full Shopify GID, e.g. gid://shopify/Collection/123456
  collectionId       String
  /// true = automation manages this collection's sort order
  enabled            Boolean   @default(true)
  /// Shopify sort type that was active before Inventex switched to MANUAL.
  originalSortOrder  String    @default("MANUAL")
  /// Merchant-selected order used for the in-stock portion of the collection.
  baseSortOrder      String    @default("MANUAL")
  /// Exact product order captured when auto-sort was enabled.
  originalProductIds Json      @default("[]")
  /// Current canonical base order, independent from availability grouping.
  baseProductIds     Json      @default("[]")
  /// Original base index captured when a product first becomes sold out.
  oosOriginalIndices Json      @default("{}")
  productCount       Int       @default(0)
  bulkOperationId    String?
  disabledReason     String?
  lastSortedAt       DateTime?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([shop, collectionId])
  @@index([shop])
}

/// Durable, multi-store-safe background work queue.
/// Webhook IDs are persisted in uniqueKey so redeliveries are idempotent.
model Job {
  id        String    @id @default(cuid())
  shop      String
  type      String
  payload   Json
  status    JobStatus @default(PENDING)
  runAfter  DateTime  @default(now())
  attempts  Int       @default(0)
  uniqueKey String
  lastError String?
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([shop, uniqueKey])
  @@index([status, runAfter])
  @@index([shop, status])
}

/// Latest canonical product availability snapshot used by downstream features.
model ProductAvailabilityState {
  id          Int       @id @default(autoincrement())
  shop        String
  productId   String
  status      String
  ignored     Boolean   @default(false)
  soldOutAt   DateTime?
  variants    Json
  evaluatedAt DateTime  @default(now())

  @@unique([shop, productId])
  @@index([shop, status])
}
